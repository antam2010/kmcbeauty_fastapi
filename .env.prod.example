# ==============================================================================
# .env.prod 템플릿 (SPEC-INFRA-001, REQ-INFRA-001)
#
# 사용법:
#   - 이 파일을 매니저 노드에서 `.env.prod` 로 복사한 뒤 실제 값을 채운다.
#       cp .env.prod.example .env.prod   # 서버에서만 수행, .env.prod 는 커밋 금지
#   - `.env.prod` 는 절대 저장소에 커밋하지 않는다(.gitignore 로 차단).
#   - 자격 증명(Firebase 키 등)은 파일이 아니라 Docker secret 으로 주입한다.
#
# 로컬 개발용 `.env` 와의 차이(중요):
#   - 로컬 `.env`      : REDIS_URL=redis://localhost:6379/0 (호스트 접근)
#   - 배포 `.env.prod` : REDIS_URL=redis://redis:6379/0     (오버레이 서비스 DNS)
#   배포에 로컬 `.env` 를 사용하면 오버레이에서 Redis 해석이 깨진다(결함 재발).
# ==============================================================================

# --- 환경 식별 --------------------------------------------------------------
# APP_ENV: 애플리케이션 런타임 환경(app.core.config). 운영은 prod.
APP_ENV=prod
# ENV: alembic/env.py 가 .env.{ENV} 를 로드할 때 사용(운영은 prod).
ENV=prod

# --- 인증/보안 --------------------------------------------------------------
# SECRET_KEY: JWT 서명 키. 강한 랜덤 값으로 교체할 것.
SECRET_KEY=__CHANGE_ME__
# ALGORITHM: JWT 서명 알고리즘.
ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_SECONDS: 액세스 토큰 만료(초).
ACCESS_TOKEN_EXPIRE_SECONDS=900
# REFRESH_TOKEN_EXPIRE_SECONDS: 리프레시 토큰 만료(초).
REFRESH_TOKEN_EXPIRE_SECONDS=1209600
# FERNET_KEY: 대칭 암호화 키(url-safe base64, 정확히 44자). 반드시 새로 생성.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=__CHANGE_ME__

# --- 데이터베이스(외부 관리형 MySQL) ----------------------------------------
# DATABASE_URL: 운영 MySQL 접속 URL. MySQL 은 컨테이너 외부(호스트/관리형)에 존재.
#   형식: mysql+pymysql://<user>:<password>@<host>:3306/<db>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://__USER__:__PASSWORD__@__HOST__:3306/__DB__?charset=utf8mb4

# --- Redis(오버레이 서비스 DNS) ---------------------------------------------
# REDIS_URL: Swarm 오버레이에서는 반드시 서비스 이름(redis)으로 접근한다.
REDIS_URL=redis://redis:6379/0

# --- 관측성 -----------------------------------------------------------------
# SENTRY_DSN: Sentry DSN. 미사용 시 빈 값.
SENTRY_DSN=

# --- Firebase(참고) ---------------------------------------------------------
# 컨테이너 내 경로는 docker-stack.yml 의 environment 에서 고정 주입한다:
#   FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/firebase_service_account
# 실제 키 파일은 Docker secret(firebase_service_account)으로만 마운트한다.
# (여기에 경로/키를 적더라도 스택 environment 설정이 우선한다.)
