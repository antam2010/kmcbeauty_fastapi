# ==============================================================================
# .env.prod 템플릿 (SPEC-INFRA-001 REQ-INFRA-001 / SPEC-INFRA-002 REQ-INFRA-108)
#
# 사용법:
#   - 이 파일을 매니저 노드에서 `.env.prod` 로 복사한 뒤 비시크릿 값을 채운다.
#       cp .env.prod.example .env.prod   # 서버에서만 수행, .env.prod 는 커밋 금지
#   - `.env.prod` 는 절대 저장소에 커밋하지 않는다(.gitignore 로 차단).
#
# 시크릿 정책(SPEC-INFRA-002):
#   - SECRET_KEY / FERNET_KEY / DATABASE_URL 은 더 이상 이 파일에 두지 않는다.
#     Docker secret(kmc_secret_key_v1 / kmc_fernet_key_v1 / kmc_database_url_v1)으로만 주입하며
#     컨테이너 내부에서는 /run/secrets/<필드명>(SECRET_KEY 등) 파일로 마운트된다.
#     등록·회전 절차는 docs/deployment.md 의 "Docker secret" 및 "회전 runbook" 절 참조.
#   - Firebase 서비스 계정 키도 Docker secret(firebase_service_account)으로 주입한다.
#   - 따라서 이 템플릿은 비시크릿 설정과 시크릿 인벤토리(주석)만 담는다.
#
# 로컬 개발용 `.env` 와의 차이(중요):
#   - 로컬 `.env`      : REDIS_URL=redis://localhost:6379/0 (호스트 접근)
#   - 배포 `.env.prod` : REDIS_URL=redis://redis:6379/0     (오버레이 서비스 DNS)
#   배포에 로컬 `.env` 를 사용하면 오버레이에서 Redis 해석이 깨진다(결함 재발).
# ==============================================================================

# --- 환경 식별 --------------------------------------------------------------
# APP_ENV: 애플리케이션 런타임 환경(app.core.config). 허용값: local|debug|stage|production — 운영은 production.
APP_ENV=production
# ENV: alembic/env.py 가 .env.{ENV} 를 로드할 때 사용(운영은 prod).
ENV=prod

# --- 인증/보안(비시크릿만) --------------------------------------------------
# ALGORITHM: JWT 서명 알고리즘.
ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_SECONDS: 액세스 토큰 만료(초).
ACCESS_TOKEN_EXPIRE_SECONDS=900
# REFRESH_TOKEN_EXPIRE_SECONDS: 리프레시 토큰 만료(초).
REFRESH_TOKEN_EXPIRE_SECONDS=1209600

# --- 시크릿 인벤토리(값 없음 — Docker secret 으로만 주입) --------------------
#   SECRET_KEY   -> Docker secret kmc_secret_key_v1   (target: SECRET_KEY)
#   FERNET_KEY   -> Docker secret kmc_fernet_key_v1   (target: FERNET_KEY)
#   DATABASE_URL -> Docker secret kmc_database_url_v1 (target: DATABASE_URL)
#   위 3개 키는 이 파일에 절대 값으로 적지 않는다(저장소 평문 노출 금지, AC-6).

# --- Redis(오버레이 서비스 DNS, 비시크릿) -----------------------------------
# REDIS_URL: Swarm 오버레이에서는 반드시 서비스 이름(redis)으로 접근한다.
#   자격 증명이 없는 내부 오버레이 DNS 이므로 시크릿화하지 않고 여기에 잔류한다(REQ-INFRA-106).
REDIS_URL=redis://redis:6379/0

# --- 관측성 -----------------------------------------------------------------
# SENTRY_DSN: Sentry DSN. 미사용 시 빈 값(빈 문자열 degrade -> Sentry 비활성).
SENTRY_DSN=

# --- Firebase(참고) ---------------------------------------------------------
# 컨테이너 내 경로는 docker-stack.yml 의 environment 에서 고정 주입한다:
#   FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/firebase_service_account
# 실제 키 파일은 Docker secret(firebase_service_account)으로만 마운트한다.
