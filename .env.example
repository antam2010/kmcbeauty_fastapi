# ==============================================================================
# .env.example — 필요한 모든 환경 변수 템플릿
# 실제 값은 .env 에 채운다(.env 는 커밋 금지). 아래 값은 예시/플레이스홀더다.
# ==============================================================================

# 환경 설정 (production | local | debug)
APP_ENV=local

# --- 데이터베이스 -------------------------------------------------------------
# 사용자가 관리하는 DB 연결 문자열
DATABASE_URL=mysql+pymysql://user:password@dbhost:3306/kmcbeauty

# --- Redis --------------------------------------------------------------------
# celery broker/backend + 앱 캐시 공용. Swarm 에서는 서비스명 'redis' 로 접근.
# 로컬 개발은 redis://localhost:6379/0 로 오버라이드.
REDIS_URL=redis://redis:6379/0

# --- 보안 ---------------------------------------------------------------------
# SECRET_KEY:  openssl rand -hex 32
# FERNET_KEY:  openssl rand -base64 32 | tr '+/' '-_'   (Fernet urlsafe base64)
SECRET_KEY=change-me-openssl-rand-hex-32
ALGORITHM=HS256
FERNET_KEY=change-me-fernet-urlsafe-base64

# --- JWT 토큰 만료 시간 (초 단위) ---------------------------------------------
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# --- Sentry (선택: 비우면 비활성화) -------------------------------------------
SENTRY_DSN=

# --- Firebase -----------------------------------------------------------------
# 서비스 계정 JSON 키의 컨테이너 내부 경로(마운트 필요). 미설정 시 FCM 초기화 실패.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/app/secrets/firebase-service-account.json
